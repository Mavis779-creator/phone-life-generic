# Copy to .env; never commit the real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_API_STYLE=responses
AI_MAX_OUTPUT_TOKENS=6000
PHONE_HOST=127.0.0.1
PHONE_PORT=8787
# Optional fixed connection token. Empty means a new random token on each start.
PHONE_AI_TOKEN=
# For a separately hosted frontend, list its exact HTTPS origin(s), comma-separated.
PHONE_ALLOWED_ORIGINS=
